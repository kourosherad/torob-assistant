# Copy this file to .env before starting the app. Never commit real keys.

# BoxAPI service key for chat completions (server-side secret).
# Create an API key in your BoxAPI account with access to BOXAPI_MODEL.
BOXAPI_API_KEY=
# OpenAI-compatible base URL supplied by BoxAPI, without /chat/completions.
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
# A model available to your BoxAPI account.
BOXAPI_MODEL=gpt-5-mini

# Local HTTP port; open http://localhost:3210 after starting the server.
PORT=3210
# For Liara, use PORT=3000, HOST=0.0.0.0 and your HTTPS site origin.
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3210

# Neshan "Services" key (server-side secret), created at platform.neshan.org.
# Enable: routing with live traffic and estimated arrival time.
# Persian panel label: مسیریابی با در نظر گرفتن ترافیک + تخمین زمان رسیدن
NESHAN_API_KEY=

# Separate Neshan "Web Map" key for the embedded map; do not reuse the Services key.
# Enable: MapLibre map tiles. Persian label: تایل نقشه - کیت توسعه maplibre
# Allow localhost for local use, and your exact site domain when deploying.
# This domain-restricted map key is intentionally sent to the browser by the SDK.
NESHAN_MAP_KEY=

# Optional local database paths. Keep both databases outside version control.
CATALOG_DB_PATH=data/torob.db
WORKFLOW_DB_PATH=data/workflow.db
